{
  "schemaVersion": 1,
  "kind": "SevenAttemptImage",
  "contract": "seven.worker-image/v1",
  "role": "attempt",
  "adapter": {
    "id": "fake",
    "version": "batch3",
    "executable": "/opt/seven/adapter/entrypoint",
    "args": [],
    "binarySha256": "__ADAPTER_SHA256__",
    "sourceSha256": "__ADAPTER_SOURCE_SHA256__",
    "protocol": {
      "name": "seven.agent-adapter",
      "min": 1,
      "max": 1
    },
    "transport": "stdio",
    "capabilities": [
      "activity",
      "execution.interrupt",
      "execution.resume",
      "execution.start",
      "execution.suspend",
      "execution.suspended",
      "interaction.closed",
      "interaction.received",
      "interaction.request",
      "interaction.respond",
      "message.received",
      "user.message"
    ]
  },
  "executionKinds": [
    "AGENT_ATTEMPT"
  ],
  "scheduling": {
    "scope": "TEST_ONLY",
    "priority": 100,
    "providerProtocols": [
      "OPENAI"
    ],
    "environmentCapabilities": [
      "language.node",
      "package-manager.pnpm",
      "shell.posix"
    ],
    "hookEvents": [
      "attempt.prepare",
      "attempt.propose",
      "attempt.end"
    ]
  },
  "metadata": {
    "name": "seven-fake-harness-batch3",
    "version": "0.1.0-dev",
    "buildRevision": "0000000",
    "description": "Fixed Batch3 answer, supplement and native-session suspend/resume fixture"
  },
  "runtime": {
    "os": "linux",
    "architectures": [
      "amd64",
      "arm64"
    ],
    "user": "10001:10001",
    "entrypoint": [
      "/usr/local/bin/seven-worker-cli",
      "supervise"
    ],
    "probeCommand": [
      "/usr/local/bin/seven-worker-cli",
      "image",
      "probe",
      "--json"
    ]
  },
  "supervisor": {
    "executable": "/usr/local/bin/seven-worker-cli",
    "version": "0.1.0-dev",
    "buildRevision": "0000000"
  },
  "protocols": {
    "attemptSpec": {
      "min": 1,
      "max": 1
    },
    "supervisorControl": {
      "min": 2,
      "max": 2
    },
    "eventEnvelope": {
      "min": 1,
      "max": 1
    },
    "completionProposal": {
      "min": 1,
      "max": 1
    },
    "hookInput": {
      "min": 1,
      "max": 1
    },
    "imageProbe": {
      "min": 1,
      "max": 1
    },
    "attemptControl": {
      "min": 1,
      "max": 1
    },
    "reviewInput": {
      "min": 1,
      "max": 1
    },
    "reviewReport": {
      "min": 1,
      "max": 1
    },
    "managedHookEvent": {
      "min": 1,
      "max": 1
    }
  },
  "harness": {
    "type": "fake",
    "adapter": "fake-deterministic-v1",
    "executable": "/usr/local/bin/seven-fake-harness",
    "version": "0.1.0-dev",
    "binarySha256": "__BINARY_SHA256__"
  },
  "hooks": {
    "mode": "managed_only",
    "requirementsPath": "/etc/codex/requirements.toml",
    "managedDir": "/opt/seven-worker/assets/hooks",
    "runner": "/usr/local/bin/seven-hook"
  },
  "resultProcessor": {
    "pythonRuntimeIdentity": "__PYTHON_RUNTIME_IDENTITY__",
    "bootstrapSha256": "__RESULT_BOOTSTRAP_SHA256__",
    "sdkSha256": "__RESULT_SDK_SHA256__",
    "moduleIndexSha256": "__RESULT_MODULE_INDEX_SHA256__",
    "moduleRoots": [
      "/opt/seven-worker/result-runtime",
      "/opt/seven-worker/result-runtime/seven_workforce_runtime"
    ]
  },
  "filesystem": {
    "taskRootTemplate": "/workspace/{task_id}",
    "attemptRootTemplate": "/workspace/{task_id}/attempts/{attempt_id}",
    "repo": {
      "pathTemplate": "/workspace/{task_id}/attempts/{attempt_id}/repo",
      "access": "read_write",
      "storage": "bind",
      "attemptPrivate": true
    },
    "input": {
      "pathTemplate": "/workspace/{task_id}/input",
      "access": "read_only",
      "storage": "bind",
      "noexec": true,
      "attemptPrivate": false
    },
    "dependencies": {
      "pathTemplate": "/workspace/{task_id}/dependencies",
      "access": "read_only",
      "storage": "bind",
      "noexec": true,
      "attemptPrivate": false
    },
    "output": {
      "pathTemplate": "/workspace/{task_id}/attempts/{attempt_id}/output",
      "access": "read_write",
      "storage": "bind",
      "attemptPrivate": true
    },
    "state": {
      "pathTemplate": "/workspace/{task_id}/attempts/{attempt_id}/state",
      "access": "read_write",
      "storage": "bind",
      "attemptPrivate": true
    },
    "cache": {
      "pathTemplate": "/workspace/{task_id}/attempts/{attempt_id}/cache",
      "access": "read_write",
      "storage": "bind",
      "attemptPrivate": true
    },
    "runtime": {
      "pathTemplate": "/workspace/{task_id}/attempts/{attempt_id}/runtime",
      "access": "read_write",
      "storage": "bind",
      "attemptPrivate": true
    },
    "temporary": {
      "pathTemplate": "/workspace/{task_id}/attempts/{attempt_id}/tmp",
      "access": "read_write",
      "storage": "bind",
      "attemptPrivate": true
    }
  },
  "assets": {
    "indexSha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e8d927374313dfb5f8d2e65",
    "items": []
  },
  "capabilities": [
    "harness.headless",
    "harness.fake",
    "provider.gateway-client",
    "completion.proposal",
    "hooks.dispatch.v1",
    "hooks.runtime.shell",
    "hooks.runtime.node22",
    "result-processor.python"
  ]
}
